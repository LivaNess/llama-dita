/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Content-Security-Policy: default-src 'self'; script-src 'self' https://cdn.jsdelivr.net; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data:; connect-src 'self' https://llamadita.com.ar https://mwzkrahindnheuheoycv.supabase.co wss://mwzkrahindnheuheoycv.supabase.co; frame-ancestors 'none'; base-uri 'self'; form-action 'self'

/descargas/*
  Content-Disposition: attachment
  Cache-Control: no-cache

/version.json
  Cache-Control: no-cache
  Access-Control-Allow-Origin: *

/update-manifest.json
  Cache-Control: no-cache
  Access-Control-Allow-Origin: *

/css/*
  Cache-Control: public, max-age=0, must-revalidate

/js/*
  Cache-Control: public, max-age=0, must-revalidate

/fonts/*
  Cache-Control: public, max-age=31536000, immutable
  Access-Control-Allow-Origin: *
